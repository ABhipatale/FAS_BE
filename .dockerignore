# Keep the build context small and, more importantly, never bake a local .env
# into the image - Render injects real environment variables at runtime and a
# copied .env would silently win over them.
.env
.env.*
!.env.example

.git
.gitignore
.github

node_modules
vendor

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

tests
phpunit.xml
README.md
CHANGELOG.md
*.zip
